rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security validation
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User root profile & subcollections
    match /users/{userId} {
      // User can read, create, update, or delete only their own document
      allow read, write: if isOwner(userId);

      // Game sessions subcollection: users/{userId}/gameSessions/{sessionId}
      match /gameSessions/{sessionId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Legacy/alias sessions subcollection: users/{userId}/sessions/{sessionId}
      match /sessions/{sessionId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Faculty performance subcollection: users/{userId}/faculties/{facultyId}
      match /faculties/{facultyId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Recursive rule for any future subcollections under users/{userId}
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Explicitly deny any operations outside the users hierarchy
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
