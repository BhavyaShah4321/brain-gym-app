# =====================================================
# OVERLOAD Mobile Application - Firebase Configuration
# =====================================================
# In Expo SDK 49+, variables prefixed with EXPO_PUBLIC_ are bundled
# and accessible client-side via process.env.EXPO_PUBLIC_*
#
# Note: Firebase client config keys are identifiers used by the SDK
# to locate your project. Security is enforced via Firestore Security Rules
# and Firebase Authentication, not secret client keys.

EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id_here
